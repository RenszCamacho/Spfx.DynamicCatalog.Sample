{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "filtro-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/filtro/FiltroWebPart.js",
          "manifest": "./src/webparts/filtro/FiltroWebPart.manifest.json"
        }
      ]
    },
    "productos-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/productos/ProductosWebPart.js",
          "manifest": "./src/webparts/productos/ProductosWebPart.manifest.json"
        }
      ]
    },
    "detalles-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/detalles/DetallesWebPart.js",
          "manifest": "./src/webparts/detalles/DetallesWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "FiltroWebPartStrings": "lib/webparts/filtro/loc/{locale}.js",
    "ProductosWebPartStrings": "lib/webparts/productos/loc/{locale}.js",
    "DetallesWebPartStrings": "lib/webparts/detalles/loc/{locale}.js"
  }
}
